{
  "type": "mod",
  "id": "nox.avatars",
  "provides": [
    "fr.hactazia.sdk.avatar",
    "avatar"
  ],
  "name": "Avatar",
  "version": "1.0.x",
  "description": "Provides the Avatar API for the game.",
  "license": "GPL-3.0",
  "icon": null,
  "contact": {
    "email": "hactazia@gmail.com",
    "source": "https://github.com/AtelierVR/nox.avatars",
    "website": "https://nox.hactazia.fr/",
    "issues": "https://github.com/AtelierVR/nox.avatars/issues"
  },
  "authors": [
    {
      "name": "Hactazia",
      "email": "hactazia@gmail.com",
      "website": "https://hactazia.fr/"
    }
  ],
  "relations": [
    {
      "id": "network",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.network.git"
    },
    {
      "id": "ui",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.ui.git"
    },
    {
      "id": "search",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.search.git"
    },
    {
      "id": "tables",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.table.git"
    },
    {
      "id": "users",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.users.git"
    },
    {
      "id": "controllers",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.controllers.git"
    },
    {
      "id": "nox.avatars.modules",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.avatars.modules.git"
    },
    {
      "id": "com.unity.animation.rigging",
      "type": "depends",
      "version": ">=1.4.0",
      "register": "upm+com.unity.animation.rigging@1.4.1"
    },
    {
      "id": "settings",
      "type": "depends",
      "version": ">=1.0.0",
      "register": "git+https://github.com/AtelierVR/nox.settings.git"
    }
  ],
  "constraints": [
    {
      "type": "after",
      "id": "network"
    },
    {
      "type": "after",
      "id": "search"
    },
    {
      "type": "after",
      "id": "settings"
    }
  ],
  "entrypoints": {
    "main": [
      "Nox.Avatars.Runtime.Main"
    ],
    "editor": [
      "Nox.Avatars.Runtime.Editor.Editor",
      "Nox.Avatars.Runtime.Editor.BuilderPanel",
      "Nox.Avatars.Runtime.Editor.PublisherPanel"
    ],
    "client": [
      "Nox.Avatars.Runtime.Client"
    ]
  }
}